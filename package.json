{
  "name": "cg-dulces",
  "version": "2.0.0",
  "private": true,
  "description": "Panel del negocio CG Dulces (ventas, caja, inventario, fiado, compras).",
  "scripts": {
    "chequeo": "node scripts/chequeo.js",
    "serve": "node scripts/servidor-local.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/app.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/app.css --watch",
    "vendor": "node ./scripts/vendor.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10"
  }
}
